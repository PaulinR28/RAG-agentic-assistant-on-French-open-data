# Copy to .env (git-ignored) and fill in. Never commit real keys.
OLLAMA_HOST=http://localhost:11434

# Generation backend: "ollama" (local, default) or "openrouter" (API, local-vs-API comparison)
LLM_BACKEND=ollama
# Model for that backend, e.g. qwen3:4b-instruct-2507-q4_K_M (ollama) or anthropic/claude-haiku-5.5 (openrouter).
# Not plain "qwen3:4b": that tag is the always-thinking variant (~500 tokens of reasoning per call).
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
OPENROUTER_API_KEY=

# Optional direct API keys, if the school provides them
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
